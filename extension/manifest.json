{
  "manifest_version": 3,
  "name": "Steven 驗證碼 OCR 助手",
  "version": "2.0.2",
  "description": "支援純瀏覽器離線 ONNX 與本機服務，按一下即可辨識圖片文字並填入鄰近欄位（不自動送出）。",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "Steven OCR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page_button.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "recognize-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "辨識並填入目前頁面的圖片文字"
    }
  }
}
